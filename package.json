{
  "name": "cyberdm",
  "version": "1.0.4",
  "description": "Free Windows download manager with browser integration",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/download-tools.js",
    "prebuild": "node scripts/download-tools.js && node scripts/build-native-host.js",
    "build": "set \"ELECTRON_BUILDER_COMPRESSION_LEVEL=1\" && electron-builder --win",
    "build:portable": "node scripts/download-tools.js && node scripts/build-native-host.js && set \"ELECTRON_BUILDER_COMPRESSION_LEVEL=1\" && electron-builder --win portable",
    "build:installer": "node scripts/download-tools.js && node scripts/build-native-host.js && set \"ELECTRON_BUILDER_COMPRESSION_LEVEL=1\" && electron-builder --win nsis",
    "pack": "electron-builder --dir",
    "lint": "echo 'No linter configured yet'",
    "format": "echo 'No formatter configured yet'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "author": "CyberDM",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "7zip-bin": "^2.1.0",
    "electron-store": "^8.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ftp": "^0.3.10",
    "node-stream-zip": "^1.15.0",
    "ssh2": "^1.14.0",
    "tar": "^6.2.1",
    "unzipper": "^0.12.3",
    "uuid": "^9.0.0",
    "webtorrent": "^2.8.5",
    "yauzl": "^3.1.0"
  },
  "build": {
    "appId": "com.cyberdm.app",
    "productName": "CyberDM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "tools/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native-host",
        "to": "native-host",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
